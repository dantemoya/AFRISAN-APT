<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>Afrisan-Nuevo-Api-Supabase-2026</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Afrisan.Nuevo.Contratos/Afrisan.Nuevo.Contratos.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.33" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- Las pruebas xUnit acceden a los almacenes en memoria y a Program para las pruebas HTTP. -->
    <InternalsVisibleTo Include="Afrisan.Nuevo.Pruebas" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../02_BASE_DATOS/07_Habilitar_Persistencia.sql" LogicalName="AFRISAN.Persistencia.sql" />
    <EmbeddedResource Include="../../02_BASE_DATOS/08_Rectificacion_Pesajes.sql" LogicalName="AFRISAN.Rectificaciones.sql" />
    <EmbeddedResource Include="../../02_BASE_DATOS/09_Mantenedores_Bajas.sql" LogicalName="AFRISAN.Mantenedores.sql" />
    <EmbeddedResource Include="../../02_BASE_DATOS/10_Costos_Limites.sql" LogicalName="AFRISAN.CostosLimites.sql" />
    <EmbeddedResource Include="PowerBi/Plantilla/*" LogicalName="AFRISAN.PowerBI.%(Filename)%(Extension)" />
    <EmbeddedResource Include="PowerBi/Conexion/AfrisanApi.pq" LogicalName="AFRISAN.Conexion.AfrisanApi.pq" />
    <EmbeddedResource Include="../PowerBI/AFRISAN.pbip" LogicalName="AFRISAN.Informe.AFRISAN.pbip" />
    <EmbeddedResource Include="../PowerBI/AFRISAN.Report/**/*" Exclude="../PowerBI/AFRISAN.Report/.pbi/**/*;../PowerBI/AFRISAN.Report/definition.pbir">
      <LogicalName>AFRISAN.Informe.AFRISAN.Report/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../PowerBI/AFRISAN.Report/definition.pbir" LogicalName="AFRISAN.Informe.AFRISAN.Report/definition.pbir" />
    <EmbeddedResource Include="../PowerBI/AFRISAN.SemanticModel/model.bim;../PowerBI/AFRISAN.SemanticModel/definition.pbism" LogicalName="AFRISAN.Informe.AFRISAN.SemanticModel/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
