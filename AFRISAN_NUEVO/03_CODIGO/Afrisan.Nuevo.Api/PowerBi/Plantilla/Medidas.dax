// Crear cada medida por separado en Modelado > Nueva medida.
// Si la configuración regional requiere ; como separador, sustituir las comas.

Cilindros registrados = COUNTROWS(Inventario)

Cilindros sin pesaje = COUNTROWS(FILTER(Inventario, ISBLANK(Inventario[KgSegunUltimoPesaje])))

Cilindros disponibles bodega = CALCULATE(COUNTROWS(Inventario), Inventario[Ubicacion] = "Bodega", Inventario[Estado] = "Disponible")

OT registradas = DISTINCTCOUNT(Ordenes[OtId])

OT abiertas = CALCULATE(DISTINCTCOUNT(Ordenes[OtId]), KEEPFILTERS(NOT (Ordenes[Estado] IN {"Cerrada", "Anulada"})))

OT cerradas = CALCULATE(DISTINCTCOUNT(Ordenes[OtId]), KEEPFILTERS(Ordenes[Estado] = "Cerrada"))

Kg solicitados = SUM(DetalleOT[KgSolicitados])

Kg autorizados = SUM(DetalleOT[KgAutorizados])

Operaciones confirmadas = COUNTROWS(Operaciones)

Kg en cilindros instalados = SUM(Operaciones[KgInstalados])

Kg en cilindros retirados = SUM(Operaciones[KgRetirados])

Retirados pendientes recepcion = CALCULATE(COUNTROWS(Operaciones), KEEPFILTERS(Operaciones[PendienteRecepcion] = TRUE()))

Incidencias abiertas = CALCULATE(COUNTROWS(Incidencias), KEEPFILTERS(Incidencias[Abierta] = TRUE()))

Despachos pendientes uso o devolucion = CALCULATE(COUNTROWS(Despachos), KEEPFILTERS(Despachos[Estado] = "EnProcesoDespacho"))

// Kg en cilindros instalados corresponde al pesaje neto al instalar. Desde D-45 es también la medida
// de consumo por sucursal (misma regla de los límites); no mide fugas ni el gas que queda en el cilindro.
// No sumar columnas de inventario para inferir existencias históricas.

Costo refrigerante CLP = SUM(Costos[TotalClp])

Gramos valorados = SUM(Costos[Gramos])

Operaciones valoradas = DISTINCTCOUNT(Costos[OperacionId])

Valoraciones sin conversion = COUNTROWS(FILTER(Costos, ISBLANK(Costos[TotalClp])))

// D-45 · Consumo por sucursal. Crear la tabla calculada Calendario (sin relaciones):
//   Calendario = VAR i1 = MIN(Operaciones[DiaConfirmacion]) VAR i2 = MIN(Ordenes[DiaCreacion])
//     VAR f1 = MAX(Operaciones[DiaConfirmacion]) VAR f2 = MAX(Ordenes[DiaCreacion])
//     VAR Inicio = COALESCE(IF(ISBLANK(i1) || (NOT ISBLANK(i2) && i2 < i1), i2, i1), TODAY())
//     VAR Fin = COALESCE(IF(ISBLANK(f1) || (NOT ISBLANK(f2) && f2 > f1), f2, f1), TODAY())
//     RETURN SELECTCOLUMNS(CALENDAR(DATE(YEAR(Inicio), MONTH(Inicio), 1), EOMONTH(Fin, 0)), "Fecha", [Date],
//       "Mes", FORMAT([Date], "mmmm yyyy"), "MesOrden", YEAR([Date]) * 100 + MONTH([Date]), "Semana", [Date] - WEEKDAY([Date], 2) + 1)
// Semana empieza el lunes, como los límites. Ordenar Mes por MesOrden.

Consumo kg (gas instalado) = CALCULATE(SUM(Operaciones[KgInstalados]), TREATAS(VALUES(Calendario[Fecha]), Operaciones[DiaConfirmacion]))

Kg solicitados por el cliente = CALCULATE(SUM(DetalleOT[KgSolicitados]), TREATAS(VALUES(Calendario[Fecha]), Ordenes[DiaCreacion]), KEEPFILTERS(Ordenes[Estado] <> "Anulada"))
