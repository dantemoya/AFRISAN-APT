@page "/cilindros/{Codigo}"
@attribute [Authorize]
@inject InventarioClient Api
@inject SesionService Sesion
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Detalle de cilindro · AFRISAN</PageTitle>
<a class="back-link" href="@(Sesion.Sesion?.Rol == "Tecnico" ? "identificar" : "inventario")">← Volver a la consulta</a>
@if (cargando) { <h1>Detalle de cilindro</h1><p class="loading" role="status">Cargando registro…</p> }
else if (cilindro is null) { <h1>No se pudo abrir el cilindro</h1><div class="notice error" role="alert">@error</div><button class="btn secondary" @onclick="Cargar">Reintentar</button> }
else
{
    <div class="page-heading"><div><span class="eyebrow">FICHA DEL CILINDRO</span><h1>@cilindro.Codigo</h1><p>@cilindro.RefrigeranteCodigo · @cilindro.RefrigeranteNombre</p></div><span class="badge large @Formato.Estilo(cilindro.Estado)">@Formato.Estado(cilindro.Estado)</span></div>
    @if (error is not null) { <div class="notice error" role="alert">@error</div> }
    @if (mensaje is not null) { <div class="notice success" role="status">@mensaje</div> }
    @if (Sesion.Sesion?.Rol=="Administrador" && Sesion.Entorno?.Modo=="PostgreSQL" && cilindro.Ubicacion=="Bodega") { <p><a class="btn secondary" href="@($"bajas-cilindros?codigo={Uri.EscapeDataString(cilindro.Codigo)}")">Gestionar baja del cilindro →</a></p> }
    <div class="detail-grid">
        <section class="panel"><h2>Datos del envase</h2><dl class="detail-list">
            <dt>Código único</dt><dd>@cilindro.Codigo</dd><dt>Número de serie</dt><dd>@(cilindro.NumeroSerie ?? "Sin registrar")</dd>
            <dt>Ubicación registrada</dt><dd>@cilindro.Ubicacion @(cilindro.Sucursal ?? cilindro.Tecnico)</dd><dt>Tipo de refrigerante</dt><dd>@cilindro.RefrigeranteCodigo</dd><dt>Capacidad máxima</dt><dd>@Formato.Gramos(cilindro.CapacidadGr)</dd>
            <dt>Tara</dt><dd>@Formato.Gramos(cilindro.TaraGr)</dd><dt>Fecha de alta</dt><dd>@cilindro.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl></section>
        <section class="panel calculation"><h2>Último pesaje registrado</h2>
            <span class="muted">Peso bruto (envase + refrigerante)</span><strong class="weight-value">@Formato.Gramos(cilindro.PesajeRegistrado?.PesoBrutoGr)</strong>
            <div class="calculation-result"><span>Contenido según pesaje</span><strong>@(cilindro.ContenidoSegunPesajeGr.HasValue ? Formato.Gramos(cilindro.ContenidoSegunPesajeGr) : "—")</strong><small>@Formato.Kg(cilindro.ContenidoSegunPesajeGr)</small></div>
            @if (cilindro.PesajeRegistrado is { } lectura) { <p class="field-help">@lectura.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @lectura.Usuario</p>@if (!string.IsNullOrWhiteSpace(lectura.Observacion)) { <p>@lectura.Observacion</p> } }
            else { <p class="field-help">No se supone lleno ni vacío: falta medirlo.</p> }
        </section>
        <section class="panel qr-panel"><h2>Identificación QR</h2>
            @if (qr is not null) { <img src="@qr" alt="@($"Código QR del cilindro {cilindro.Codigo}")" width="170" height="170" /><strong>@cilindro.Codigo</strong><button class="btn secondary" @onclick="DescargarQr">Descargar QR</button> }
            else { <p class="muted">No se pudo generar el QR. Actualiza la ficha para reintentar.</p> }
        </section>
    </div>
    @if (cilindro.PesajeRegistrado is null && cilindro.Ubicacion == "Bodega" && Sesion.PuedeRegistrar)
    {
        <section class="panel mt"><h2>Registrar primer pesaje</h2><p class="muted">Lectura de ingreso. No genera una salida, retorno ni consumo.</p>
            <EditForm Model="form" OnValidSubmit="GuardarPesaje"><DataAnnotationsValidator /><ValidationSummary />
                <fieldset disabled="@guardando"><div class="form-grid"><div><label for="peso-inicial">Peso bruto (g)</label><InputNumber id="peso-inicial" @bind-Value="form.PesoBrutoGr" step="1" min="0" /></div>
                    <div><label for="foto-inicial">Foto de la balanza</label><InputFile id="foto-inicial" accept="image/jpeg,image/png,image/webp" OnChange="CargarFotoInicial" /><small class="field-help">Obligatoria: respalda el peso registrado.</small></div>
                    <div><label for="observacion-inicial">Observación (opcional)</label><InputText id="observacion-inicial" @bind-Value="form.Observacion" maxlength="1000" /></div></div>
                    <button class="btn primary" type="submit">@(guardando ? "Guardando…" : "Registrar pesaje inicial")</button></fieldset>
            </EditForm>
        </section>
    }
    @if (cilindro.Ubicacion == "Bodega" && cilindro.Estado is "Vacio" or "Disponible" && cilindro.PesajeRegistrado is not null && Sesion.PuedeRegistrar)
    {
        <section class="panel mt"><h2>Registrar recarga</h2><p class="muted">Cuando el cilindro vuelve recargado, pésalo en Bodega y adjunta la foto de la balanza. Queda «Disponible» para nuevas órdenes.</p>
            <fieldset disabled="@guardando"><div class="form-grid">
                <div><label for="recarga-peso">Peso bruto recargado (g)</label><input id="recarga-peso" type="number" step="1" min="1" @bind="pesoRecarga" @bind:after="NuevaRecarga" /></div>
                <div><label for="recarga-foto">Foto de la balanza</label><InputFile id="recarga-foto" accept="image/jpeg,image/png,image/webp" OnChange="CargarFotoRecarga" /></div>
                <div><label for="recarga-observacion">Observación (opcional)</label><input id="recarga-observacion" maxlength="1000" @bind="notaRecarga" /></div>
            </div><button class="btn primary" @onclick="Recargar">@(guardando ? "Guardando…" : "Registrar recarga")</button></fieldset>
        </section>
    }
    @if (Sesion.Sesion?.Rol != "Tecnico")
    {
        <section class="panel mt"><h2>Pesajes y fotos de la balanza</h2><p class="muted">Cada pesaje conserva su foto para verificar el monto registrado.</p>
            @if (errorPesajes is not null) { <div class="notice error" role="alert">@errorPesajes</div> }
            else if (pesajes.Length == 0) { <p class="muted">Sin pesajes registrados.</p> }
            else
            {
                <div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Tipo</th><th>Peso bruto</th><th>OT</th><th>Usuario</th><th>Foto</th></tr></thead><tbody>
                    @foreach (var p in pesajes)
                    {
                        <tr><td>@p.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@TipoPesaje(p.Tipo)</td><td class="nowrap">@Formato.Gramos(p.PesoBrutoGr)</td><td class="nowrap">@(p.Orden ?? "—")</td><td>@p.Usuario</td>
                            <td>@if (p.Fotos.Length == 0) { <span class="muted">Sin foto (registro anterior)</span> }
                                else { @foreach (var f in p.Fotos) { <button class="btn secondary small" @onclick="() => VerFoto(p, f)">Ver foto</button> } }</td></tr>
                    }
                </tbody></table></div>
            }
            @if (fotoVista is not null)
            {
                <figure class="pesaje-foto"><img src="@fotoVista" alt="@fotoTitulo" /><figcaption>@fotoTitulo</figcaption><button class="btn secondary" @onclick="() => { fotoVista = null; fotoTitulo = null; }">Cerrar foto</button></figure>
            }
        </section>
    }
    <section class="panel mt"><h2>Historial del registro</h2>
        <ol class="timeline">@foreach (var evento in historial) { <li><span>@evento.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @evento.Usuario</span><strong>@evento.Accion</strong><p>@evento.Descripcion</p></li> }</ol>
    </section>
    <p class="fine-print">La información corresponde a la instancia de revisión. La ubicación y el último pesaje se actualizan al registrar entregas, instalaciones, retiros y recepciones.</p>
}

@code {
    [Parameter] public string Codigo { get; set; } = "";
    private CilindroResponse? cilindro;
    private EventoResponse[] historial = [];
    private readonly PesajeForm form = new();
    private string? qr, error, mensaje;
    private bool cargando = true, guardando;
    protected override Task OnParametersSetAsync() => Cargar();
    private async Task DescargarQr()
    {
        if (qr is null || cilindro is null) return;
        try
        {
            await using var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/qr-reader.js");
            await modulo.InvokeVoidAsync("downloadQr", qr, $"{cilindro.Codigo}.png");
        }
        catch (JSException) { error = "El navegador no pudo descargar el QR. Vuelve a intentarlo."; }
    }
    private async Task Cargar()
    {
        cargando = true; error = null; qr = null; cilindro = null; historial = [];
        try { cilindro = await Api.CilindroAsync(Codigo); historial = await Api.HistorialAsync(Codigo); }
        catch (Exception ex) { error = Formato.Error(ex); }
        finally { cargando = false; }
        pesajes = []; errorPesajes = null; fotoVista = null;
        if (cilindro is not null && Sesion.Sesion?.Rol != "Tecnico")
        {
            try { pesajes = await Api.PesajesAsync(Codigo); }
            catch (Exception ex) { errorPesajes = Formato.Error(ex); }
        }
        if (cilindro is not null)
        {
            try { qr = await Api.QrAsync(Codigo); }
            catch (Exception ex) { error = Formato.Error(ex); }
        }
    }
    private long? pesoRecarga;
    private string? notaRecarga;
    private FotoPesajeRequest? fotoRecarga;
    private Guid idRecarga = Guid.NewGuid();
    private void NuevaRecarga() => idRecarga = Guid.NewGuid();
    private async Task CargarFotoRecarga(InputFileChangeEventArgs args)
    {
        error = null; fotoRecarga = null; idRecarga = Guid.NewGuid();
        const long maximo = 4 * 1024 * 1024;
        if (args.File.Size > maximo) { error = "La foto supera 4 MiB."; return; }
        await using var origen = args.File.OpenReadStream(maximo);
        using var memoria = new MemoryStream();
        await origen.CopyToAsync(memoria);
        fotoRecarga = new() { Id = Guid.NewGuid(), Nombre = args.File.Name, ContentType = args.File.ContentType, Base64 = Convert.ToBase64String(memoria.ToArray()) };
    }
    private async Task Recargar()
    {
        if (guardando) return;
        if (pesoRecarga is null || fotoRecarga is null) { error = "Ingresa el peso recargado y adjunta la foto de la balanza."; return; }
        guardando = true; error = null; mensaje = null;
        try
        {
            await Api.RecargarAsync(Codigo, new() { IdOperacion = idRecarga, PesoBrutoGr = pesoRecarga.Value, Foto = fotoRecarga, Observacion = notaRecarga });
            pesoRecarga = null; notaRecarga = null; fotoRecarga = null; idRecarga = Guid.NewGuid();
            await Cargar(); mensaje = "Recarga registrada: el cilindro quedó disponible en Bodega.";
        }
        catch (Exception ex) { error = Formato.Error(ex); }
        finally { guardando = false; }
    }
    private PesajeEvidenciaResponse[] pesajes = [];
    private string? errorPesajes, fotoVista, fotoTitulo;
    private FotoPesajeRequest? fotoInicial;
    private static string TipoPesaje(string tipo) => tipo switch
    {
        "Inicial" => "Pesaje inicial", "Despacho" => "Retiro de Bodega", "Instalado" => "Instalado en sucursal",
        "Retirado" => "Retirado de sucursal", "Recepcion" => "Recepción en Bodega", "Recarga" => "Recarga", _ => tipo
    };
    private async Task VerFoto(PesajeEvidenciaResponse p, FotoPesajeInfo f)
    {
        errorPesajes = null;
        try { fotoVista = await Api.FotoPesajeAsync(Codigo, f); fotoTitulo = $"{TipoPesaje(p.Tipo)} · {Formato.Gramos(p.PesoBrutoGr)} · {p.Fecha.ToLocalTime():dd/MM/yyyy HH:mm}"; }
        catch (Exception ex) { errorPesajes = Formato.Error(ex); }
    }
    private async Task CargarFotoInicial(InputFileChangeEventArgs args) => fotoInicial = await LeerFoto(args);
    private async Task<FotoPesajeRequest?> LeerFoto(InputFileChangeEventArgs args)
    {
        error = null;
        const long maximo = 4 * 1024 * 1024;
        if (args.File.Size > maximo) { error = "La foto supera 4 MiB."; return null; }
        await using var origen = args.File.OpenReadStream(maximo);
        using var memoria = new MemoryStream();
        await origen.CopyToAsync(memoria);
        return new() { Id = Guid.NewGuid(), Nombre = args.File.Name, ContentType = args.File.ContentType, Base64 = Convert.ToBase64String(memoria.ToArray()) };
    }
    private async Task GuardarPesaje()
    {
        if (guardando || form.PesoBrutoGr is null) return;
        if (fotoInicial is null) { error = "Adjunta la foto de la balanza con el peso inicial."; return; }
        guardando = true; error = null; mensaje = null;
        try { await Api.PesarAsync(Codigo, new() { PesoBrutoGr = form.PesoBrutoGr.Value, Observacion = form.Observacion, Foto = fotoInicial }); fotoInicial = null; await Cargar(); mensaje = "Pesaje inicial registrado con su foto. El historial conserva la lectura y el usuario."; }
        catch (Exception ex) { error = Formato.Error(ex); }
        finally { guardando = false; }
    }
}
