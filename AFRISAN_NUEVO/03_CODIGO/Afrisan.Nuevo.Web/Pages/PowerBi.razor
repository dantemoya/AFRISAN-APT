@page "/power-bi/operativo"
@attribute [Authorize(Roles = RolesBi.Consulta)]
@inject InventarioClient Api
@inject SesionService Sesion
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.JSInterop
@using System.Globalization

<PageTitle>Power BI · AFRISAN</PageTitle>
<p><a class="btn secondary" href="power-bi/demo">Abrir demostración con datos simulados →</a></p>
<div class="page-heading">
    <div><span class="eyebrow">INFORMACIÓN PARA GESTIÓN</span><h1>Power BI</h1><p>Inventario, órdenes y trabajo en terreno.</p></div>
    <button class="btn primary" disabled="@(cargando || descargando || !persistente)" @onclick="Descargar">@(descargando ? "Preparando paquete…" : "Descargar paquete Power BI")</button>
</div>
@if(error is not null){<div class="notice error" role="alert">@error</div>}
@if(mensaje is not null){<div class="notice success" role="status">@mensaje</div>}
@if(!persistente)
{
    <div class="notice info">Este módulo necesita la conexión PostgreSQL. Abre la instalación con registros persistentes.</div>
}
else
{
    <section class="panel bi-report" aria-labelledby="titulo-informe">
        <div class="section-heading"><h2 id="titulo-informe">Informe de Power BI</h2><span class="stage-pill">@(config?.Configurado == true ? "CONFIGURADO" : "PENDIENTE DE PUBLICACIÓN")</span></div>
        @if(config?.Configurado == true)
        {
            <p class="muted">Microsoft solicitará tu cuenta y comprobará el acceso al informe. Los filtros de la vista previa inferior se aplican solo a esa vista.</p>
            <p><a class="btn secondary" href="@config.AbrirUrl" target="_blank" rel="noopener noreferrer">Abrir en Power BI ↗</a></p>
            <iframe title="Informe operativo AFRISAN en Power BI" src="@config.EmbedUrl" class="bi-frame" allowfullscreen="true" referrerpolicy="no-referrer"></iframe>
            <p class="muted">Si no carga o el navegador bloquea el inicio de sesión, usa «Abrir en Power BI».</p>
        }
        else if(cargando){<p role="status">Consultando configuración…</p>}
        else
        {
            <p>El paquete incluye el proyecto editable del informe con seis páginas. Falta revisarlo en Power BI Desktop y publicarlo.</p>
            <ol class="bi-steps"><li>Descarga el paquete y descomprímelo en una carpeta privada.</li><li>Abre Informe/AFRISAN.pbip en Power BI Desktop y sigue LEEME.md para conectar los CSV, actualizar y guardar el PBIX.</li><li>Publica el informe y configura su identificador en el servidor para verlo aquí.</li></ol>
            <p class="muted">El paquete incluye los registros completos al momento de descargarlo. Su actualización es manual.</p>
        }
    </section>
    <section class="panel bi-report" aria-labelledby="titulo-conexion">
        <div class="section-heading"><h2 id="titulo-conexion">Conexión directa desde Power BI</h2><span class="stage-pill">TOKEN DE 30 DÍAS</span></div>
        <p>Genera un token para que Power BI lea las tablas desde la API. Dura 30 días y solo permite leer las tablas: no sirve para entrar a la aplicación ni para modificar datos.</p>
        <p class="muted">Conviene generarlo con una cuenta de Jefatura dedicada a Power BI. Para revocarlo antes de su vencimiento, cambia la contraseña de esa cuenta o desactívala.</p>
        <h3>Opción simple: proyecto listo para abrir</h3>
        <ol class="bi-steps"><li>Descarga el proyecto y descomprímelo fuera del repositorio (incluye el token).</li><li>Con la API encendida, abre <code>AFRISAN.pbip</code> en Power BI Desktop.</li><li>Pulsa <strong>Actualizar</strong>. Si pide credenciales, elige «Anónimo».</li></ol>
        <div class="form-actions"><button class="btn primary" disabled="@(descargandoConectado || !persistente)" @onclick="DescargarConectado">@(descargandoConectado ? "Preparando proyecto…" : "Descargar Power BI conectado")</button></div>
        <h3>Opción manual: solo el token</h3>
        @if(token is null)
        {
            <button class="btn secondary" disabled="@generando" @onclick="GenerarToken">@(generando ? "Generando…" : "Generar token para Power BI")</button>
        }
        else
        {
            <div class="notice info" role="status">Copia el token ahora: no se vuelve a mostrar. Vence el @token.Vence.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</div>
            <label for="bi-token">Token</label>
            <textarea id="bi-token" class="bi-token" readonly rows="4" spellcheck="false">@token.Token</textarea>
            <div class="form-actions"><button class="btn primary" @onclick="CopiarToken">Copiar token</button></div>
            <p class="bi-token-url">Dirección de cada tabla: <code>@(Api.UrlTablasPowerBi){tabla}</code>. Tablas: @string.Join(", ", token.Tablas).</p>
            <p class="muted">En Power BI usa autenticación «Anónima» y envía el token en el encabezado <code>Authorization: Bearer …</code>. Los pasos están en POWER_BI.md.</p>
        }
    </section>
    <div class="section-heading mt"><h2>Vista previa operativa</h2><span class="muted">Consulta directa de AFRISAN</span></div>
    <p class="muted">Esta vista usa la base actual. El informe publicado tendrá su propia fecha de actualización.</p>
    <section class="panel" aria-label="Filtros de la vista previa">
        <div class="filter-bar">
            <div><label for="bi-desde">Desde</label><input id="bi-desde" type="date" @bind="desde" disabled="@cargando" /></div>
            <div><label for="bi-hasta">Hasta</label><input id="bi-hasta" type="date" @bind="hasta" disabled="@cargando" /></div>
            <div><label for="bi-sucursal">Sucursal</label><select id="bi-sucursal" @bind="sucursalId" disabled="@cargando"><option value="">Todas</option>@foreach(var x in sucursales){<option value="@x.Id">@x.Nombre</option>}</select></div>
            <div><label for="bi-refrigerante">Refrigerante</label><select id="bi-refrigerante" @bind="refrigeranteId" disabled="@cargando"><option value="">Todos</option>@foreach(var x in refrigerantes){<option value="@x.Id">@x.Nombre</option>}</select></div>
            <div><label for="bi-tecnico">Técnico</label><select id="bi-tecnico" @bind="tecnicoId" disabled="@cargando"><option value="">Todos</option>@foreach(var x in tecnicos){<option value="@x.Id">@x.Nombre</option>}</select></div>
        </div>
        <div class="form-actions"><button class="btn subtle" disabled="@cargando" @onclick="Limpiar">Restablecer</button><button class="btn primary" disabled="@cargando" @onclick="Cargar">@(cargando ? "Consultando…" : "Aplicar filtros / Actualizar")</button></div>
    </section>
    @if(resumen is not null)
    {
        <p class="muted bi-cut" role="status">Corte: @resumen.GeneradoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · Período: @resumen.Desde.ToString("dd/MM/yyyy") al @resumen.Hasta.ToString("dd/MM/yyyy") (Chile).</p>
        <div class="metric-grid" aria-busy="@cargando">
            <div class="metric"><span>Cilindros al corte</span><strong>@resumen.Cilindros</strong><small>@resumen.SinPesaje sin pesaje · no usa filtro de fecha</small></div>
            <div class="metric"><span>OT abiertas</span><strong>@resumen.OrdenesAbiertas</strong><small>Creadas en el período · @resumen.OrdenesCerradas cerradas@(resumen.OrdenesAnuladas > 0 ? $" · {resumen.OrdenesAnuladas} anuladas" : "")</small></div>
            <div class="metric"><span>Kg en cilindros instalados</span><strong>@Numero(resumen.KgInstalados)</strong><small>Operaciones confirmadas en el período</small></div>
            <div class="metric"><span>Retirados pendientes</span><strong>@resumen.RetiradosPendientes</strong><small>Reemplazos confirmados en el período, aún sin recepción</small></div>
            <div class="metric"><span>Incidencias abiertas</span><strong>@resumen.IncidenciasAbiertas</strong><small>Registradas en el período, aún sin revisión</small></div>
        </div>
        <div class="bi-chart-grid">
            @Grafico("Inventario por estado",resumen.InventarioPorEstado,"cilindros")
            @Grafico("Órdenes por estado",resumen.OrdenesPorEstado,"OT")
            @Grafico("Kg instalados por refrigerante",resumen.InstaladosPorRefrigerante,"kg")
        </div>
        @Consumo(resumen.ConsumoPorSucursal ?? [])
        <div class="notice info mt">Los kilos representan el contenido neto medido al instalar el cilindro. Los estados y pendientes corresponden al corte actual. Para revisar todos los pendientes históricos, amplía el período.</div>
    }
    else if(cargando){<p role="status">Cargando indicadores…</p>}
}

@code {
    private PowerBiConfiguracionResponse? config;
    private BiResumenResponse? resumen;
    private BiOpcionResponse[] sucursales=[],refrigerantes=[],tecnicos=[];
    private DateTime? desde,hasta;
    private int? sucursalId,tecnicoId;
    private long? refrigeranteId;
    private bool cargando,descargando,generando;
    private string? error,mensaje;
    private TokenPowerBiResponse? token;
    private bool persistente=>Sesion.Entorno?.Modo=="PostgreSQL";
    private static string Numero(decimal n)=>n.ToString("N2",CultureInfo.GetCultureInfo("es-CL"));
    private static string Entero(decimal n)=>n.ToString("N0",CultureInfo.GetCultureInfo("es-CL"));
    protected override Task OnInitializedAsync()=>persistente?Cargar():Task.CompletedTask;
    private async Task Cargar()
    {
        if(cargando)return;
        cargando=true;error=null;mensaje=null;
        try
        {
            if(desde>hasta)throw new InvalidOperationException("La fecha inicial debe ser anterior o igual a la final.");
            var conf=Api.PowerBiConfiguracionAsync();
            var datos=Api.PowerBiResumenAsync(desde,hasta,sucursalId,refrigeranteId,tecnicoId);
            await Task.WhenAll(conf,datos);
            config=await conf;resumen=await datos;
            desde=resumen.Desde.ToDateTime(TimeOnly.MinValue);hasta=resumen.Hasta.ToDateTime(TimeOnly.MinValue);
            sucursales=resumen.Sucursales;refrigerantes=resumen.Refrigerantes;tecnicos=resumen.Tecnicos;
        }
        catch(Exception ex){error=Formato.Error(ex);resumen=null;}
        finally{cargando=false;}
    }
    private Task Limpiar(){desde=null;hasta=null;sucursalId=null;refrigeranteId=null;tecnicoId=null;return Cargar();}
    private async Task Descargar()
    {
        if(descargando)return;
        descargando=true;error=null;mensaje=null;
        try
        {
            var bytes=await Api.PowerBiPaqueteAsync();
            using var stream=new MemoryStream(bytes);
            using var referencia=new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("afrisanBi.descargar",$"AFRISAN_PowerBI_{DateTime.UtcNow:yyyyMMdd_HHmmss}.zip",referencia);
            mensaje="Paquete descargado con todos los registros. Descomprímelo y abre LEEME.md para crear el informe.";
        }
        catch(Exception ex){error=Formato.Error(ex);}
        finally{descargando=false;}
    }
    private bool descargandoConectado;
    private async Task DescargarConectado()
    {
        if(descargandoConectado)return;
        descargandoConectado=true;error=null;mensaje=null;
        try
        {
            var bytes=await Api.PowerBiProyectoConectadoAsync();
            using var stream=new MemoryStream(bytes);
            using var referencia=new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("afrisanBi.descargar",$"AFRISAN_PowerBI_Conectado_{DateTime.Now:yyyyMMdd_HHmm}.zip",referencia);
            mensaje="Proyecto descargado. Descomprímelo, abre AFRISAN.pbip en Power BI Desktop y pulsa Actualizar.";
        }
        catch(Exception ex){error=Formato.Error(ex);}
        finally{descargandoConectado=false;}
    }
    private async Task GenerarToken()
    {
        if(generando)return;
        generando=true;error=null;mensaje=null;
        try{token=await Api.TokenPowerBiAsync();}
        catch(Exception ex){error=Formato.Error(ex);}
        finally{generando=false;}
    }
    private async Task CopiarToken()
    {
        if(token is null)return;
        try{await JS.InvokeVoidAsync("navigator.clipboard.writeText",token.Token);mensaje="Token copiado. Pégalo en Power BI y no lo compartas.";}
        catch(JSException){error="El navegador no permitió copiar. Selecciona el token y cópialo con Ctrl+C.";}
    }
    // D-45: consumo por sucursal (kg instalados) con los kg solicitados, por semana o mes; un color por empresa cliente.
    // Sin estilos en línea, para que la CSP pueda quedar en style-src 'self' (Plan_mitigacion_CSP.md): el color de cada
    // empresa es una de las clases .cliente-0 a .cliente-7 de app.css y el ancho de cada barra va en el atributo width de un rect SVG.
    private string periodo="Mes";
    private const int ColoresClientes=8;
    private static string Etiqueta(string periodo,DateOnly inicio)=>periodo=="Semana"
        ?$"Semana del {inicio:dd/MM} al {inicio.AddDays(6):dd/MM/yyyy}"
        :inicio.ToString("MMMM 'de' yyyy",CultureInfo.GetCultureInfo("es-CL"));
    private static string Ancho(decimal valor,decimal maximo)=>
        (valor<=0||maximo<=0?0m:Math.Max(1m,Math.Round(valor*100m/maximo,1))).ToString(CultureInfo.InvariantCulture)+"%";
    private RenderFragment Consumo(BiConsumoResponse[] consumo)
    {
        var clientes=consumo.Select(x=>x.Cliente??"Sin cliente").Distinct().Order().ToArray();
        string Color(string? cliente)=>$"cliente-{Array.IndexOf(clientes,cliente??"Sin cliente")%ColoresClientes}";
        var filas=consumo.Where(x=>x.Periodo==periodo).ToArray();
        var maximo=filas.Length==0?0m:filas.Max(x=>Math.Max(x.KgInstalados,x.KgSolicitados));
        return @<section class="panel bi-consumo mt" aria-labelledby="titulo-consumo">
            <div class="section-heading"><h3 id="titulo-consumo">Consumo de refrigerante por sucursal</h3>
                <div class="bi-toggle" role="group" aria-label="Agrupar el consumo por">
                    @foreach(var p in new[]{"Semana","Mes"}){var opcion=p;<button type="button" class="btn @(periodo==opcion?"primary":"secondary")" aria-pressed="@(periodo==opcion?"true":"false")" @onclick="()=>periodo=opcion">@opcion</button>}
                </div>
            </div>
            <p class="muted bi-nota">Barra de color: kg netos instalados en la sucursal, con la misma regla de los límites. Barra gris: kg solicitados por el cliente en OT no anuladas. Usa los filtros de arriba.</p>
            @if(filas.Length==0){<p class="muted">Sin registros para estos filtros.</p>}
            else
            {
                <div class="bi-leyenda" aria-label="Colores por empresa">@foreach(var c in clientes){<span><i class="@Color(c)"></i>@c</span>}<span><i class="sol"></i>Kg solicitados</span></div>
                @foreach(var grupo in filas.GroupBy(x=>x.Inicio).OrderBy(g=>g.Key))
                {
                    <h4>@Etiqueta(periodo,grupo.Key)</h4>
                    <ul aria-label="@Etiqueta(periodo,grupo.Key)">
                        @foreach(var f in grupo)
                        {
                            <li><div><span>@f.Sucursal<small>@(f.Cliente??"Sin cliente")</small></span><strong>@Numero(f.KgInstalados) kg · solicitados @Numero(f.KgSolicitados) kg</strong></div>
                                <div class="bi-barras" role="img" aria-label="@($"{f.Sucursal}: {Numero(f.KgInstalados)} kg instalados y {Numero(f.KgSolicitados)} kg solicitados")">
                                    <svg width="100%" height="14" aria-hidden="true" focusable="false"><rect class="@Color(f.Cliente)" width="@Ancho(f.KgInstalados,maximo)" height="14" rx="4" /></svg>
                                    <svg class="sol" width="100%" height="6" aria-hidden="true" focusable="false"><rect width="@Ancho(f.KgSolicitados,maximo)" height="6" rx="3" /></svg>
                                </div></li>
                        }
                    </ul>
                }
            }
        </section>;
    }
    private RenderFragment Grafico(string titulo,BiGrupoResponse[] grupos,string unidad)=>@<section class="panel bi-chart"><h3>@titulo</h3>
        @if(grupos.Length==0){<p class="muted">Sin registros para estos filtros.</p>}
        else
        {
            // Los conteos (cilindros, OT) van sin decimales y con el nombre del estado que usa el resto de la aplicación.
            var conteo=unidad!="kg";
            <ul aria-label="@titulo">@foreach(var g in grupos){var nombre=conteo?Formato.Estado(g.Nombre):g.Nombre;var valor=conteo?Entero(g.Valor):Numero(g.Valor);<li><div><span>@nombre</span><strong>@valor @unidad</strong></div><meter min="0" max="@Math.Max(1m,grupos.Max(x=>x.Valor))" value="@g.Valor" aria-label="@($"{nombre}: {valor} {unidad}")">@g.Valor</meter></li>}</ul>
        }
    </section>;
}
