{
  "name": "AFRISAN",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-CL",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Inventario",
        "columns": [
          {
            "name": "CilindroId",
            "dataType": "string",
            "sourceColumn": "CilindroId",
            "summarizeBy": "none"
          },
          {
            "name": "Codigo",
            "dataType": "string",
            "sourceColumn": "Codigo",
            "summarizeBy": "none"
          },
          {
            "name": "RefrigeranteId",
            "dataType": "string",
            "sourceColumn": "RefrigeranteId",
            "summarizeBy": "none"
          },
          {
            "name": "Refrigerante",
            "dataType": "string",
            "sourceColumn": "Refrigerante",
            "summarizeBy": "none"
          },
          {
            "name": "Estado",
            "dataType": "string",
            "sourceColumn": "Estado",
            "summarizeBy": "none"
          },
          {
            "name": "Ubicacion",
            "dataType": "string",
            "sourceColumn": "Ubicacion",
            "summarizeBy": "none"
          },
          {
            "name": "SucursalId",
            "dataType": "string",
            "sourceColumn": "SucursalId",
            "summarizeBy": "none"
          },
          {
            "name": "Sucursal",
            "dataType": "string",
            "sourceColumn": "Sucursal",
            "summarizeBy": "none"
          },
          {
            "name": "TecnicoId",
            "dataType": "string",
            "sourceColumn": "TecnicoId",
            "summarizeBy": "none"
          },
          {
            "name": "Tecnico",
            "dataType": "string",
            "sourceColumn": "Tecnico",
            "summarizeBy": "none"
          },
          {
            "name": "KgSegunUltimoPesaje",
            "dataType": "double",
            "sourceColumn": "KgSegunUltimoPesaje",
            "summarizeBy": "none"
          },
          {
            "name": "FechaPesaje",
            "dataType": "dateTime",
            "sourceColumn": "FechaPesaje",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Inventario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Afrisan[Inventario]"
            }
          }
        ],
        "measures": [
          {
            "name": "Cilindros registrados",
            "expression": "COUNTROWS(Inventario)",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Cilindros sin pesaje",
            "expression": "COUNTROWS(FILTER(Inventario, ISBLANK(Inventario[KgSegunUltimoPesaje])))",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Cilindros disponibles bodega",
            "expression": "CALCULATE(COUNTROWS(Inventario), Inventario[Ubicacion] = \"Bodega\", Inventario[Estado] = \"Disponible\")",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "OT registradas",
            "expression": "CALCULATE(DISTINCTCOUNT(Ordenes[OtId]), TREATAS(VALUES(DetalleOT[OtId]), Ordenes[OtId]))",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "OT abiertas",
            "expression": "CALCULATE(DISTINCTCOUNT(Ordenes[OtId]), TREATAS(VALUES(DetalleOT[OtId]), Ordenes[OtId]), KEEPFILTERS(Ordenes[Estado] <> \"Cerrada\"))",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "OT cerradas",
            "expression": "CALCULATE(DISTINCTCOUNT(Ordenes[OtId]), TREATAS(VALUES(DetalleOT[OtId]), Ordenes[OtId]), KEEPFILTERS(Ordenes[Estado] = \"Cerrada\"))",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Kg solicitados",
            "expression": "SUM(DetalleOT[KgSolicitados])",
            "formatString": "#,0.00",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Kg autorizados",
            "expression": "SUM(DetalleOT[KgAutorizados])",
            "formatString": "#,0.00",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Operaciones confirmadas",
            "expression": "COUNTROWS(Operaciones)",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Kg en cilindros instalados",
            "expression": "SUM(Operaciones[KgInstalados])",
            "formatString": "#,0.00",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Kg en cilindros retirados",
            "expression": "SUM(Operaciones[KgRetirados])",
            "formatString": "#,0.00",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Retirados pendientes recepcion",
            "expression": "CALCULATE(COUNTROWS(Operaciones), KEEPFILTERS(Operaciones[PendienteRecepcion] = TRUE()))",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Incidencias abiertas",
            "expression": "CALCULATE(COUNTROWS(Incidencias), TREATAS(VALUES(DetalleOT[OtId]), Incidencias[OtId]), KEEPFILTERS(Incidencias[Abierta] = TRUE()))",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Despachos pendientes uso o devolucion",
            "expression": "CALCULATE(COUNTROWS(Despachos), KEEPFILTERS(Despachos[Estado] = \"EnProcesoDespacho\"))",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Costo refrigerante CLP",
            "expression": "SUM(Costos[TotalClp])",
            "formatString": "#,0.00######",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Gramos valorados",
            "expression": "SUM(Costos[Gramos])",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Operaciones valoradas",
            "expression": "DISTINCTCOUNT(Costos[OperacionId])",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          },
          {
            "name": "Valoraciones sin conversion",
            "expression": "COUNTROWS(FILTER(Costos, ISBLANK(Costos[TotalClp])))",
            "formatString": "#,0",
            "displayFolder": "Indicadores operativos"
          }
        ]
      },
