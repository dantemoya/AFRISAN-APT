        ],
        "partitions": [
          {
            "name": "Sucursales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Todos = Table.Combine({Table.SelectColumns(Afrisan[Ordenes], {\"SucursalId\", \"Sucursal\"}), Table.SelectColumns(Afrisan[Inventario], {\"SucursalId\", \"Sucursal\"})}), Valid = Table.SelectRows(Todos, each [SucursalId] <> null), Unicos = Table.Distinct(Valid, {\"SucursalId\"}) in Unicos"
            }
          }
        ]
      },
